  "primaryColor": "green",
  "primaryShade": {
    "light": 7,
    "dark": 6
  },
  "white": "#F7F2E6",
  "black": "#0B0D09",
  "autoContrast": true,
  "luminanceThreshold": 0.3,
  "isThemeDependentPrimaryShade": true,
  "defaultGradient": {
    "from": "red",
    "to": "green",
    "deg": 45
  },
  "fontFamily": "Noto Sans",
  "fontFamilyMonospace": "Roboto Mono",
  "headings": {
    "fontFamily": "Commissioner",
    "fontWeight": "800",
    "sizes": {
      "h1": {
        "fontSize": "calc(2.125rem * var(--mantine-scale))",
        "lineHeight": "1.3",
        "fontWeight": "800"
      },
      "h2": {
        "fontSize": "calc(1.625rem * var(--mantine-scale))",
        "lineHeight": "1.35",
        "fontWeight": "800"
      },
      "h3": {
        "fontSize": "calc(1.375rem * var(--mantine-scale))",
        "lineHeight": "1.4",
        "fontWeight": "700"
      },
      "h4": {
        "fontSize": "calc(1.125rem * var(--mantine-scale))",
        "lineHeight": "1.45",
        "fontWeight": "700"
      },
      "h5": {
        "fontSize": "calc(1rem * var(--mantine-scale))",
        "lineHeight": "1.5",
        "fontWeight": "600"
      },
      "h6": {
        "fontSize": "calc(0.875rem * var(--mantine-scale))",
        "lineHeight": "1.5",
        "fontWeight": "600"
      }
    }
  },
  "scale": 1,
  "radius": {
    "xs": "calc(0.125rem * var(--mantine-scale))",
    "sm": "calc(0.25rem * var(--mantine-scale))",
    "md": "calc(0.5rem * var(--mantine-scale))",
    "lg": "calc(1rem * var(--mantine-scale))",
    "xl": "calc(2rem * var(--mantine-scale))"
  },
  "spacing": {
    "xs": "calc(0.625rem * var(--mantine-scale))",
    "sm": "calc(0.75rem * var(--mantine-scale))",
    "md": "calc(1rem * var(--mantine-scale))",
    "lg": "calc(1.25rem * var(--mantine-scale))",
    "xl": "calc(2rem * var(--mantine-scale))"
  },
  "defaultRadius": "sm",
  "breakpoints": {
    "xs": "36em",
    "sm": "48em",
    "md": "62em",
    "lg": "75em",
    "xl": "88em"
  },
  "fontSmoothing": true,
  "focusRing": "auto"
}
